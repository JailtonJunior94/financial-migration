{
  "name": "financial-migration",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run src/bootstrap/cli.ts",
    "build": "bun build ./src/bootstrap/cli.ts --outfile ./dist/cli.js --target bun",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx @biomejs/biome check .",
    "format": "bunx @biomejs/biome format --write .",
    "test": "bun test",
    "test:integration": "bun test --preload ./test/integration/preload.ts ./test/integration",
    "openapi:generate": "bunx openapi-typescript ./openapi/target-service.openapi.json -o ./src/generated/target-api.ts"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "mssql": "^12.1.0",
    "openapi-fetch": "^0.14.0",
    "pino": "^10.1.0",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/mssql": "^12.3.0",
    "@types/node": "^24.0.15",
    "ai-spec-dev": "^0.60.0",
    "bun-types": "^1.3.14",
    "openapi-typescript": "^7.9.1",
    "typescript": "^5.9.2"
  }
}
